# Purchase Memory — шаблон переменных окружения (ТОЛЬКО ИМЕНА, без значений).
#
# Этот файл в проекте должен оставаться пустым. Если хотите держать значения
# в локальном файле, СКОПИРУЙТЕ его ВНЕ проекта, например:
#   mkdir -p ~/.config/purchase-memory
#   cp docs/secrets.template.env ~/.config/purchase-memory/secrets.env
#   chmod 600 ~/.config/purchase-memory/secrets.env
# и заполните копию. Подробности: docs/ПЕРЕМЕННЫЕ_И_СЕКРЕТЫ.md.
#
# Значения пишите в двойных кавычках: в строке подключения есть «;», без
# кавычек zsh её обрежет. Пример: ConnectionStrings__Postgres="Host=…;Port=5432;…"
#
# [С] — секрет, [П] — публичное значение.

# --- Вход (Supabase Auth) ---
# [П] Project URL, https://<ref>.supabase.co
Auth__SupabaseUrl=
# [П] sb_publishable_…
Auth__SupabasePublishableKey=

# --- База данных ---
# [П] Sqlite (по умолчанию) или Postgres
Database__Provider=
# [С] строка Session pooler, содержит пароль БД
ConnectionStrings__Postgres=

# --- Фото чеков ---
# [П] Local (по умолчанию) или S3
Storage__Provider=
# [П] https://<ref>.storage.supabase.co/storage/v1/s3
Storage__S3__ServiceUrl=
# [П] регион проекта, например eu-central-1
Storage__S3__Region=
# [П] receipts
Storage__S3__Bucket=
# [С] Access key ID из Storage → S3 access keys
Storage__S3__AccessKeyId=
# [С] Secret access key (показывается один раз)
Storage__S3__SecretAccessKey=

# --- Распознавание ---
# [С] ключ Anthropic (Claude Haiku — основной путь, платные вызовы)
ANTHROPIC_API_KEY=
# [С] ключ OpenAI (запасной путь распознавания, категории, «Аналитика»; платно)
OPENAI_API_KEY=
# [С] необязательно: ключ Ollama cloud (запасной путь)
OLLAMA_API_KEY=

# --- Выделение текста строки на фото (необязательно) ---
# [П] https://<имя>.cognitiveservices.azure.com/
AZURE_DOCINTEL_ENDPOINT=
# [С] ключ Azure Document Intelligence (F0 — бесплатно, 500 страниц в месяц)
AZURE_DOCINTEL_KEY=
