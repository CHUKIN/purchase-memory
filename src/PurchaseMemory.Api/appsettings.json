{
  "Paths": {
    "DataDirectory": "../../data",
    "LogDirectory": "../../logs"
  },
  "ReceiptRecognition": {
    "Pipeline": "anthropic",
    "FallbackPipelines": ["openai", "ollama"],
    "Mode": "Vision",
    "BaseAddress": "http://127.0.0.1:11434",
    "OcrModel": "glm-ocr:latest",
    "ParserModel": "qwen3.5:4b",
    "VisionModel": "gemma4:31b-cloud",
    "RowsParserModel": "qwen3.5:35b",
    "RowsParserMaximumOutputTokens": 16384,
    "RowsParserRequestTimeoutSeconds": 1800,
    "RequestTimeoutSeconds": 600,
    "ContextLength": 32768,
    "MaximumOutputTokens": 8192,
    "OpenAiModel": "gpt-6-sol",
    "OpenAiImageDetail": "High",
    "OpenAiReasoningEffort": "Low",
    "OpenAiRequestTimeoutSeconds": 300,
    "OpenAiMaximumOutputTokens": 16384,
    "AnthropicModel": "claude-haiku-5-5",
    "AnthropicEffort": "Low",
    "AnthropicRequestTimeoutSeconds": 120,
    "AnthropicMaximumOutputTokens": 16384,
    "AnthropicMaximumRetries": 1
  },
  "Categorization": {
    "Enabled": true,
    "Model": "gpt-6-luna",
    "BatchSize": 40,
    "RequestTimeoutSeconds": 60,
    "MaximumOutputTokens": 8000,
    "ReasoningEffort": "Low"
  },
  "Analytics": {
    "Enabled": true,
    "Model": "gpt-6-luna",
    "RequestTimeoutSeconds": 30,
    "MaximumOutputTokens": 2000,
    "ReasoningEffort": "Low",
    "TimeZone": "Europe/Warsaw"
  },
  "Auth": {
    "SupabaseUrl": "",
    "SupabasePublishableKey": "",
    "Providers": ["email", "google"],
    "Audience": "authenticated",
    "DevelopmentBypass": false
  },
  "RateLimiting": {
    "ReceiptUploads": {
      "TokenLimit": 10,
      "TokensPerPeriod": 1,
      "ReplenishmentPeriodSeconds": 180
    },
    "AnalyticsQuestions": {
      "TokenLimit": 20,
      "TokensPerPeriod": 1,
      "ReplenishmentPeriodSeconds": 180
    }
  },
  "AllowedHosts": "*"
}
