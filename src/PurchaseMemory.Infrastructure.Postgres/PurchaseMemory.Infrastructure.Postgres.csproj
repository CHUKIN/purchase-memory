<Project Sdk="Microsoft.NET.Sdk">
  <!-- EF Core migrations for the Postgres (Supabase) provider only. SQLite
       migrations stay in PurchaseMemory.Infrastructure/Persistence/Migrations. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Generated migrations pass constant column arrays; that is EF's style. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PurchaseMemory.Infrastructure/PurchaseMemory.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>
</Project>
