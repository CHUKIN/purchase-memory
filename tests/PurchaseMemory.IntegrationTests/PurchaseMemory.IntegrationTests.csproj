<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PurchaseMemory.Api/PurchaseMemory.Api.csproj" />
    <ProjectReference Include="../../src/PurchaseMemory.Application/PurchaseMemory.Application.csproj" />
    <ProjectReference Include="../../src/PurchaseMemory.Domain/PurchaseMemory.Domain.csproj" />
    <ProjectReference Include="../../src/PurchaseMemory.Infrastructure/PurchaseMemory.Infrastructure.csproj" />
    <ProjectReference Include="../../tools/PurchaseMemory.ProductBackfill/PurchaseMemory.ProductBackfill.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Network-free core of the benchmark's openai command (the tool itself is an exe). -->
    <Compile Include="../../tools/PurchaseMemory.ReceiptBenchmarks/OpenAiBenchmarkCore.cs" Link="Benchmarks/OpenAiBenchmarkCore.cs" />
    <Compile Include="../../tools/PurchaseMemory.FindByPhotoBenchmark/FindByPhotoBenchmarkCore.cs" Link="Benchmarks/FindByPhotoBenchmarkCore.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../docs/contracts/receipt-extract-result-v3.schema.json"
          Link="receipt-extract-result-v3.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Ground-truth pairs for the offline highlight matching check (stage 1.3). -->
    <None Include="TestData/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
