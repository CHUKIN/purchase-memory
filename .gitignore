# Build outputs (.NET, IDEs)
**/bin/
**/obj/
*.user
*.suo
.idea/
.vscode/
.DS_Store

# Runtime state is intentionally kept outside source control: the real
# database, receipt photos, backups and logs live here.
data/
logs/
*.log
*.db
*.db-*
*.sqlite
*.sqlite-*

# Scratch folders and locally built helpers (the Apple sidecar binary is
# produced by scripts/build-apple-sidecar.sh).
tmp/
.artifacts/

# Frontend: dependencies, build output and diagnostics. The SPA in
# src/PurchaseMemory.Api/wwwroot is generated by `npm run build` (Vite outDir,
# emptied on every build; the Dockerfile builds it again); its sources are in
# src/PurchaseMemory.Web/public and src/PurchaseMemory.Web/src.
node_modules/
src/PurchaseMemory.Api/wwwroot/
**/storybook-static/
src/PurchaseMemory.Web/debug-storybook.log

# Test and coverage outputs
**/TestResults/
coverage/
*.coverage
*.trx
playwright-report/
test-results/

# Public receipt images are downloaded locally for tests but are not redistributed.
test-data/receipts/*.jpg
test-data/receipts/*.png
test-data/receipts/*.webp

# Personal household receipts (owner's own purchases): nothing is committed
# except text (ground truth, OCR text, notes, scripts). Photos in any format,
# the compiled ocr_only helper and run logs stay local.
test-data/receipts/household-*/**
!test-data/receipts/household-*/**/
!test-data/receipts/household-*/**/*.json
!test-data/receipts/household-*/**/*.md
!test-data/receipts/household-*/**/*.txt
!test-data/receipts/household-*/**/*.py
!test-data/receipts/household-*/**/*.sh
!test-data/receipts/household-*/**/*.swift

# Secrets: filled-in env files never belong in the project; only the empty
# template does.
.env
.env.*
*.env
!docs/secrets.template.env
*.pem
*.key
*.p12
*.pfx

# Local Linux compose data folder (see docs/ДЕПЛОЙ_RENDER.md).
pm-data/
